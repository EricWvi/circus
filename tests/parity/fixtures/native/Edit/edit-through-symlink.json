    "captured_at": "{{TIME}}"
  },
  "case": "edit-through-symlink",
  "description": "Read then edit a relative symlink and observe the link and target.",
  "setup": {
    "files": {
      "real.txt": "alpha\nbeta\ngamma\n"
    },
    "dirs": [],
    "symlinks": {
      "link.txt": "real.txt"
    }
  },
  "steps": [
    {
      "tool": "Read",
      "input": {
        "file_path": "{{CWD}}/link.txt"
      },
      "result": {
        "is_error": false,
        "content": "1\talpha\n2\tbeta\n3\tgamma\n4\n\n<system-reminder>\n<total_tokens>14999965 tokens left</total_tokens>\n</system-reminder>"
      },
      "attachments": []
    },
    {
      "tool": "Edit",
      "input": {
        "file_path": "{{CWD}}/link.txt",
        "old_string": "beta",
        "new_string": "BETA"
      },
      "result": {
        "is_error": true,
        "content": "Refusing to write {{CWD}}/link.txt: it is a symbolic link. Write to the link's target path instead: {{CWD}}/real.txt.\n\n<system-reminder>\n<total_tokens>14999965 tokens left</total_tokens>\n</system-reminder>"
      },
      "attachments": []
    }
  ],
  "files_after": {
    "real.txt": "alpha\nbeta\ngamma\n"
  },
  "fs_after": {
    "link.txt": {
      "type": "symlink",
      "link_target": "real.txt",
      "mode": "0777",
      "same_inode_as": null
    },
    "real.txt": {
      "type": "file",
      "mode": "0644",
      "same_inode_as": null
    }
  }
