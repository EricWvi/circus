{
  "meta": {
    "claude_code_version": "2.1.319",
    "sdk_version": "0.3.319",
    "captured_at": "{{TIME}}"
  },
  "case": "write-dangling-symlink",
  "description": "Write a dangling symlink and observe whether its target is created.",
  "setup": {
    "files": {},
    "dirs": [],
    "symlinks": {
      "link.txt": "missing.txt"
    }
  },
  "steps": [
    {
      "tool": "Write",
      "input": {
        "file_path": "{{CWD}}/link.txt",
        "content": "replacement\n"
      },
      "result": {
        "is_error": true,
        "content": "Refusing to write {{CWD}}/link.txt: it is a symbolic link. Write to the link's target path instead: {{CWD}}/missing.txt.\n\n<system-reminder>\n<total_tokens>14999965 tokens left</total_tokens>\n</system-reminder>"
      },
      "attachments": []
    }
  ],
  "files_after": {},
  "fs_after": {
    "link.txt": {
      "type": "symlink",
      "link_target": "missing.txt",
      "mode": "0777",
      "same_inode_as": null
    },
    "missing.txt": {
      "type": "missing",
      "same_inode_as": null
    }
  }
}
