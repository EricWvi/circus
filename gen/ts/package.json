    "./circus/v1/daemon_link_pb": {
      "types": "./dist/circus/v1/daemon_link_pb.d.ts",
      "default": "./dist/circus/v1/daemon_link_pb.js"
    },
    "./circus/v1/worker_link_pb": {
      "types": "./dist/circus/v1/worker_link_pb.d.ts",
