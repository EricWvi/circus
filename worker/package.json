{
  "name": "@circus/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm -w @circus/proto run build && tsc -p tsconfig.json",
    "typecheck": "npm -w @circus/proto run build && tsc --noEmit -p tsconfig.test.json",
    "test": "npm -w @circus/proto run build && vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@circus/proto": "0.0.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "vitest": "5.1.0"
  },
  "imports": {
    "#worker/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  }
}
